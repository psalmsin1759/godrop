PORT=4000
NODE_ENV=development

# Email (Mailtrap SMTP — see src/services/emailService.ts)
# Sandbox host/creds are shown in the Mailtrap dashboard under Sending Domains.
# For live sending, use your live SMTP credentials instead (host is usually live.smtp.mailtrap.io).
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USER=your_mailtrap_smtp_user
MAILTRAP_PASS=your_mailtrap_smtp_pass

# Sender identity
EMAIL_FROM_NAME=Godrop
EMAIL_FROM_ADDRESS=noreply@godrop.ng

# System admin seed (used by prisma seed)
SUPER_ADMIN_EMAIL=superadmin@godrop.ng
SUPER_ADMIN_PASSWORD=Change_Me_Now_123!

# Database (PostgreSQL recommended)
DATABASE_URL="postgres://e001bc5e4f7f6cb9150b9799ff77ce03c5784fdf912135ef5f6b88cb23c14904:sk_uj_AiJtM9WmJwamm39WOl@db.prisma.io:5432/postgres?sslmode=require"

