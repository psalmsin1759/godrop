PORT=4000
NODE_ENV=development

# Email (Mailtrap REST API — see src/services/emailService.ts)
# MAILTRAP_API_KEY: API token from https://mailtrap.io/settings/api-tokens
#   Sandbox and live sending use different tokens — a sandbox-scoped token will
#   401 against the live endpoint and vice versa.
# MAILTRAP_USE_SANDBOX=true  → sends to https://sandbox.api.mailtrap.io/api/send/{MAILTRAP_INBOX_ID}
# MAILTRAP_USE_SANDBOX=false → sends to https://send.api.mailtrap.io/api/send  (live)
# MAILTRAP_INBOX_ID: numeric inbox ID shown in the Mailtrap dashboard (sandbox only)
MAILTRAP_API_KEY=your_mailtrap_api_token
MAILTRAP_USE_SANDBOX=true
MAILTRAP_INBOX_ID=your_sandbox_inbox_id

# Sender identity
EMAIL_FROM_NAME=Godrop
EMAIL_FROM_ADDRESS=noreply@godrop.ng

# System admin seed (used by prisma seed)
SUPER_ADMIN_EMAIL=superadmin@godrop.ng
SUPER_ADMIN_PASSWORD=Change_Me_Now_123!

# Database (PostgreSQL recommended)
DATABASE_URL="postgres://e001bc5e4f7f6cb9150b9799ff77ce03c5784fdf912135ef5f6b88cb23c14904:sk_uj_AiJtM9WmJwamm39WOl@db.prisma.io:5432/postgres?sslmode=require"

# JWT
JWT_SECRET=myscretkey123
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=myscretrefreshkey123
JWT_REFRESH_EXPIRES_IN=30d

# CORS
ALLOWED_ORIGINS=https://dashboard.naijagodrop.com,https://naijagodrop.com,http://localhost:3000,http://localhost:3001

# URLs used in email links
DASHBOARD_URL=https://dashboard.naijagodrop.com
APP_DOMAIN=https://naijagodrop.com

# Paystack (Nigerian payment gateway)
PAYSTACK_SECRET_KEY=sk_test_7da8363b91e51b4f868aefb767273b64dd625d99
PAYSTACK_PUBLIC_KEY=pk_test_97ee6074455a1ee3f750f748f4580c0773168b1b

# OTP / SMS provider — selects the implementation in src/services/sms
SMS_PROVIDER=termii

# Termii (https://developer.termii.com/messaging-api)
TERMII_BASE_URL=https://v3.api.termii.com
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=OE Alert

# Google Maps (for routing + geocoding)
GOOGLE_MAPS_API_KEY=your_google_maps_key

# Redis (for sessions, caching, real-time tracking)
REDIS_URL=redis://localhost:6379

# File storage (Cloudinary or AWS S3)
CLOUDINARY_CLOUD_NAME=db0wxev2x
CLOUDINARY_API_KEY=887818879817374
