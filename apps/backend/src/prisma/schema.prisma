generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ─────────────────────────────────────────────────────

model User {
  id                   String     @id @default(cuid())
  phone                String     @unique
  firstName            String?
  lastName             String?
  email                String?    @unique
  avatarUrl            String?
  referralCode         String?    @unique
  isVerified           Boolean    @default(false)
  status               UserStatus @default(ACTIVE)
  passwordHash         String?
  passwordResetToken   String?    @unique
  passwordResetExpiry  DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  wallet        Wallet?
  addresses     SavedAddress[]
  orders        Order[]
  reviews       Review[]
  notifications Notification[]
  pushTokens    PushToken[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  savedCards    SavedCard[]
  favorites     Favorite[]
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Otp {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Profile ──────────────────────────────────────────────────

model SavedAddress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  label     String
  address   String
  lat       Float
  lng       Float
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── Favorites ────────────────────────────────────────────────

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, vendorId])
  @@index([userId])
  @@index([vendorId])
}

// ─── Wallet ───────────────────────────────────────────────────

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id])
  balanceKobo  Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String       @id @default(cuid())
  walletId    String
  wallet      Wallet       @relation(fields: [walletId], references: [id])
  type        WalletTxType
  amountKobo  Int
  reference   String?      @unique
  description String?
  createdAt   DateTime     @default(now())

  @@index([walletId])
}

enum WalletTxType {
  TOPUP
  PAYMENT
  REFUND
}

// ─── Saved Cards (Paystack tokenisation) ─────────────────────

model SavedCard {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  authorizationCode  String
  cardType           String?
  last4              String?
  expMonth           String?
  expYear            String?
  bank               String?
  email              String
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([userId])
}

// ─── Vendors ──────────────────────────────────────────────────

model Vendor {
  id               String       @id @default(cuid())
  type             VendorType
  status           VendorStatus @default(PENDING)
  name             String
  description      String?
  logoUrl          String?
  coverUrl         String?
  address          String
  lat              Float
  lng              Float
  phone            String?
  email            String?
  cuisines         String[]
  rating           Float        @default(0)
  ratingCount      Int          @default(0)
  estimatedMinutes Int          @default(30)
  isOpen                 Boolean      @default(true)
  isActive               Boolean      @default(true)
  openingHours           Json?
  rejectionReason        String?
  documents              Json?
  cashOnDeliveryEnabled  Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  categories   ProductCategory[]
  orders       Order[]
  reviews      Review[]
  admins       Admin[]
  auditLogs    AuditLog[]
  wallet       VendorWallet?
  bankAccount  VendorBankAccount?
  favorites    Favorite[]
}

enum VendorType {
  RESTAURANT
  GROCERY
  RETAIL
  PHARMACY
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum RiderKycStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

// ─── Vendor Wallet ────────────────────────────────────────────

model VendorWallet {
  id           String                  @id @default(cuid())
  vendorId     String                  @unique
  vendor       Vendor                  @relation(fields: [vendorId], references: [id])
  balanceKobo  Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  transactions VendorWalletTransaction[]
}

model VendorWalletTransaction {
  id           String   @id @default(cuid())
  walletId     String
  wallet       VendorWallet @relation(fields: [walletId], references: [id])
  type         VendorWalletTxType
  amountKobo   Int
  reference    String?  @unique
  description  String?
  createdAt    DateTime @default(now())

  @@index([walletId])
}

enum VendorWalletTxType {
  CREDIT
  WITHDRAWAL
}

model VendorBankAccount {
  id            String   @id @default(cuid())
  vendorId      String   @unique
  vendor        Vendor   @relation(fields: [vendorId], references: [id])
  bankName      String
  bankCode      String
  accountNumber String
  accountName   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model VendorWithdrawal {
  id            String                  @id @default(cuid())
  vendorId      String
  amountKobo    Int
  bankName      String
  bankCode      String
  accountNumber String
  accountName   String
  reference     String?                 @unique
  status        VendorWithdrawalStatus  @default(PENDING)
  notes         String?
  processedAt   DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([vendorId])
}

enum VendorWithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─── Admin ────────────────────────────────────────────────────

// Singleton row (id = "global") — platform-wide configuration set by admins
model PlatformSettings {
  id                       String  @id @default("global")
  riderEarningRate         Float   @default(0.8)
  coverageRadiusKm         Float   @default(15)
  vendorPlatformFeeRate    Float   @default(0.2)  // fraction platform keeps from vendor orders (0–1)
  paystackPublicKey        String?
  paystackSecretKey        String?
  standardDeliveryFeeKobo  Int     @default(75000)   // ₦750 baseline delivery fee
  serviceChargeKobo        Int     @default(25000)   // ₦250 platform service charge
  costPerKmKobo            Int     @default(10000)   // ₦100 per km charged on top
  updatedAt                DateTime @updatedAt
}

model Admin {
  id         String    @id @default(cuid())
  type       AdminType
  role       AdminRole
  vendorId   String?
  vendor     Vendor?   @relation(fields: [vendorId], references: [id])
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])
  email      String    @unique
  firstName  String
  lastName   String
  password   String
  settings   Json?
  isActive            Boolean   @default(true)
  receiveVendorEmails Boolean   @default(false)
  receiveRiderEmails  Boolean   @default(false)
  passwordResetToken  String?   @unique
  passwordResetExpiry DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  auditLogs     AuditLog[]
  notifications AdminNotification[]

  @@index([vendorId])
  @@index([businessId])
}

enum AdminType {
  SYSTEM
  VENDOR
  BUSINESS
}

enum AdminRole {
  // System roles
  SUPER_ADMIN
  ADMIN
  // Vendor roles
  OWNER
  MANAGER
  STAFF
}

// ─── Audit Log ────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id])
  vendorId  String?
  vendor    Vendor?  @relation(fields: [vendorId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([vendorId])
  @@index([userId])
  @@index([createdAt])
}

model ProductCategory {
  id        String    @id @default(cuid())
  vendorId  String
  vendor    Vendor    @relation(fields: [vendorId], references: [id])
  name      String
  description String?
  imageUrl  String?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([vendorId])
}

model Product {
  id          String          @id @default(cuid())
  categoryId  String
  category    ProductCategory @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  priceKobo   Int
  imageUrl    String?
  isAvailable Boolean         @default(true)
  stock       Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  orderItems OrderItem[]

  @@index([categoryId])
}

// ─── Parcel ───────────────────────────────────────────────────

model ParcelVehicleType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  imageUrl    String?
  baseFeeKobo Int
  perKmKobo   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]
}

// ─── Truck ────────────────────────────────────────────────────

model TruckType {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  capacity    String?
  imageUrl    String?
  baseFeeKobo Int
  perKmKobo   Int
  isActive    Boolean @default(true)

  orders Order[]
}

model ApartmentType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  priceKobo   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]
}

// Singleton row (id = "singleton") stores global truck pricing rates.
model TruckPricingConfig {
  id            String   @id @default("singleton")
  perKmKobo     Int      @default(0)
  perLoaderKobo Int      @default(0)
  updatedAt     DateTime @updatedAt
}

// ─── Orders ───────────────────────────────────────────────────

model Order {
  id           String        @id @default(cuid())
  trackingCode String        @unique
  customerId   String
  customer     User          @relation(fields: [customerId], references: [id])
  type         OrderType
  status       OrderStatus   @default(PENDING)

  vendorId    String?
  vendor      Vendor?    @relation(fields: [vendorId], references: [id])
  truckTypeId String?
  truckType   TruckType? @relation(fields: [truckTypeId], references: [id])
  parcelVehicleTypeId String?
  parcelVehicleType   ParcelVehicleType? @relation(fields: [parcelVehicleTypeId], references: [id])
  apartmentTypeId String?
  apartmentType   ApartmentType? @relation(fields: [apartmentTypeId], references: [id])
  numLoaders      Int?

  pickupAddress  String
  pickupLat      Float
  pickupLng      Float
  dropoffAddress String
  dropoffLat     Float
  dropoffLng     Float
  stops          Json?

  packageDescription String?
  weightKg           Float?
  sizeCategory       String?
  recipientName      String?
  recipientPhone     String?

  riderId String?
  rider   Rider?  @relation(fields: [riderId], references: [id])

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  paystackRef   String?       @unique

  subtotalKobo    Int @default(0)
  deliveryFeeKobo Int @default(0)
  serviceFeeKobo  Int @default(0)
  discountKobo    Int @default(0)
  totalKobo       Int

  scheduledAt      DateTime?
  estimatedMinutes Int?

  confirmationCode   String?
  idempotencyKey     String?    @unique

  notes              String?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    OrderItem[]
  events   OrderEvent[]
  review   Review?
  earnings RiderEarning[]
  dropoffs ParcelDropoff[]

  @@index([customerId])
  @@index([vendorId])
  @@index([riderId])
  @@index([status])
  @@index([apartmentTypeId])
}

enum OrderType {
  FOOD
  GROCERY
  RETAIL
  PHARMACY
  PARCEL
  TRUCK
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  FAILED
}

enum PaymentMethod {
  CARD
  WALLET
  CASH
  WALLET_CARD
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  name          String
  unitPriceKobo Int
  quantity      Int
  totalKobo     Int
  notes         String?

  @@index([orderId])
}

model OrderEvent {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id])
  status      OrderStatus
  description String?
  createdAt   DateTime    @default(now())

  @@index([orderId])
}

// A single parcel within a (possibly multi-parcel) order. Each drop-off has its
// own destination, recipient, optional description/weight, confirmation code,
// fee and — once delivered — earning. A single-parcel order has exactly one row.
model ParcelDropoff {
  id                 String      @id @default(cuid())
  orderId            String
  order              Order       @relation(fields: [orderId], references: [id])
  sequence           Int         // 1-based order of stops
  address            String
  lat                Float
  lng                Float
  recipientName      String
  recipientPhone     String
  packageDescription String?
  weightKg           Float?
  sizeCategory       String?
  status             OrderStatus @default(PENDING)
  confirmationCode   String
  deliveryFeeKobo    Int
  earningKobo        Int?
  distanceKm         Float?
  failureReason      String?
  deliveredAt        DateTime?
  createdAt          DateTime    @default(now())

  earning RiderEarning?

  @@index([orderId])
}

// ─── Riders ───────────────────────────────────────────────────

model Rider {
  id           String         @id @default(cuid())
  firstName    String
  lastName     String
  phone        String         @unique
  email        String?        @unique
  avatarUrl    String?
  dateOfBirth  DateTime?
  gender       String?

  streetAddress String?
  city          String?
  state         String?
  landmark      String?

  vehicleType  String?
  vehiclePlate String?
  vehicleColor String?
  vehicleModel String?
  vehicleYear  Int?

  driverLicenseNumber    String?
  driverLicenseExpiry    DateTime?
  vehicleInsuranceExpiry DateTime?

  bankName      String?
  bankCode      String?
  accountNumber String?
  accountName   String?

  bvn           String?
  nin           String?
  kycStatus     RiderKycStatus @default(PENDING)
  kycNotes      String?

  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?

  guarantors Json?
  documents  Json?

  lat         Float?
  lng         Float?
  isAvailable Boolean  @default(false)
  isActive    Boolean  @default(true)
  rating      Float    @default(0)
  ratingCount Int      @default(0)
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders        Order[]
  reviews       Review[]
  refreshTokens RiderRefreshToken[]
  pushTokens    RiderPushToken[]
  notifications RiderNotification[]
  earnings      RiderEarning[]
  withdrawals   RiderWithdrawal[]

  @@index([businessId])
}

// ─── Heroes ───────────────────────────────────────────────────

model Hero {
  id         String   @id @default(cuid())
  badge      String?
  heading    String
  subheading String
  imageUrl   String?
  align      String   @default("left")
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  ctaLabel   String?
  ctaLink    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Contact Messages ─────────────────────────────────────────

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model RiderRefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  riderId   String
  rider     Rider    @relation(fields: [riderId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([riderId])
}

model RiderPushToken {
  id        String   @id @default(cuid())
  riderId   String
  rider     Rider    @relation(fields: [riderId], references: [id])
  token     String
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([riderId, token])
}

model RiderNotification {
  id        String   @id @default(cuid())
  riderId   String
  rider     Rider    @relation(fields: [riderId], references: [id])
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([riderId])
  @@index([riderId, isRead])
}

model RiderEarning {
  id              String             @id @default(cuid())
  riderId         String
  rider           Rider              @relation(fields: [riderId], references: [id])
  orderId         String
  order           Order              @relation(fields: [orderId], references: [id])
  parcelDropoffId String?            @unique
  parcelDropoff   ParcelDropoff?     @relation(fields: [parcelDropoffId], references: [id])
  amountKobo      Int
  status          RiderEarningStatus @default(PENDING)
  settledAt       DateTime?
  createdAt       DateTime           @default(now())

  @@index([riderId])
  @@index([orderId])
}

enum RiderEarningStatus {
  PENDING
  SETTLED
}

model RiderWithdrawal {
  id            String                @id @default(cuid())
  riderId       String
  rider         Rider                 @relation(fields: [riderId], references: [id])
  amountKobo    Int
  bankName      String
  bankCode      String
  accountNumber String
  accountName   String
  reference     String?               @unique
  status        RiderWithdrawalStatus @default(PENDING)
  notes         String?
  processedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([riderId])
}

enum RiderWithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─── Reviews ──────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  vendorId  String?
  vendor    Vendor?  @relation(fields: [vendorId], references: [id])
  riderId   String?
  rider     Rider?   @relation(fields: [riderId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([vendorId])
  @@index([userId])
  @@index([riderId])
}

// ─── Notifications ────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
}

model AdminNotification {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id])
  type      String
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([adminId, isRead])
}

// ─── Promotions ───────────────────────────────────────────────

model Promotion {
  id           String   @id @default(cuid())
  code         String   @unique
  description  String
  type         String   // percent | fixed
  value        Int
  maxDiscount  Int?
  minOrderKobo Int?
  orderTypes   String[]
  usageLimit   Int?
  usageCount   Int      @default(0)
  validFrom    DateTime
  validUntil   DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String?
  linkType  String?
  linkValue String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── Business (rider fleet operator) ─────────────────────────

model Business {
  id      String         @id @default(cuid())
  name    String
  status  BusinessStatus @default(ACTIVE)

  // ── Contact ──────────────────────────────────────────────
  email   String?  @unique
  phone   String?
  address String?

  // ── Registration ─────────────────────────────────────────
  cacRegistrationNumber String?
  tin                   String?
  yearEstablished       Int?

  // ── Owner ────────────────────────────────────────────────
  ownerFullName    String?
  ownerPhoneNumber String?
  ownerEmail       String?
  ownerNIN         String?
  ownerBVN         String?

  // ── Operations ───────────────────────────────────────────
  serviceAreas String[]

  // ── Documents ─────────────────────────────────────────────
  cacCertificateUrl    String?
  driversLicenseUrl    String?
  insuranceDocumentUrl String?
  utilityBillUrl       String?

  // ── Banking ──────────────────────────────────────────────
  bankName      String?
  accountName   String?
  accountNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admins Admin[]
  riders Rider[]
  wallet BusinessWallet?
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model BusinessWallet {
  id           String                      @id @default(cuid())
  businessId   String                      @unique
  business     Business                    @relation(fields: [businessId], references: [id])
  balanceKobo  Int                         @default(0)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  transactions BusinessWalletTransaction[]
}

model BusinessWalletTransaction {
  id          String               @id @default(cuid())
  walletId    String
  wallet      BusinessWallet       @relation(fields: [walletId], references: [id])
  riderId     String?
  type        BusinessWalletTxType
  amountKobo  Int
  reference   String?              @unique
  description String?
  createdAt   DateTime             @default(now())

  @@index([walletId])
}

enum BusinessWalletTxType {
  RIDER_EARNING
  WITHDRAWAL
}

// ─── Invest (GoDrop Invest app) ───────────────────────────────

model Investor {
  id                 String                @id @default(cuid())
  firstName          String
  lastName           String
  username           String?               @unique
  email              String                @unique
  phone              String                @unique
  passwordHash       String
  avatarUrl          String?
  dateOfBirth        DateTime?
  address            String?
  referralCode       String?               @unique
  isPhoneVerified    Boolean               @default(false)
  isEmailVerified    Boolean               @default(false)
  bvnStatus          InvestorKycStepStatus @default(NOT_STARTED)
  idStatus           InvestorKycStepStatus @default(NOT_STARTED)
  addressProofStatus InvestorKycStepStatus @default(NOT_STARTED)
  status             UserStatus            @default(ACTIVE)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  wallet        InvestorWallet?
  settings      InvestorSettings?
  refreshTokens InvestorRefreshToken[]
  transactions  InvestorTransaction[]
  investments   Investment[]
  vaults        FlowSafeVault[]
  bankAccounts  InvestorBankAccount[]
  notifications InvestorNotification[]
}

enum InvestorKycStepStatus {
  NOT_STARTED
  IN_REVIEW
  VERIFIED
  REJECTED
}

model InvestorRefreshToken {
  id         String   @id @default(cuid())
  token      String   @unique
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id])
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([investorId])
}

model InvestorSettings {
  id                String   @id @default(cuid())
  investorId        String   @unique
  investor          Investor @relation(fields: [investorId], references: [id])
  biometricLogin    Boolean  @default(false)
  twoFactorAuth     Boolean  @default(false)
  payoutAlerts      Boolean  @default(true)
  investmentUpdates Boolean  @default(true)
  promotions        Boolean  @default(false)
  emailStatements   Boolean  @default(true)
  currency          String   @default("NGN")
  language          String   @default("English")
  appLockTimeoutMin Int      @default(1)
  updatedAt         DateTime @updatedAt
}

model InvestorWallet {
  id                String   @id @default(cuid())
  investorId        String   @unique
  investor          Investor @relation(fields: [investorId], references: [id])
  mainBalanceKobo   Int      @default(0)
  payoutBalanceKobo Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model InvestorTransaction {
  id          String             @id @default(cuid())
  investorId  String
  investor    Investor           @relation(fields: [investorId], references: [id])
  type        InvestorTxType
  wallet      InvestorWalletKind @default(MAIN)
  amountKobo  Int
  reference   String?            @unique
  description String?
  status      InvestorTxStatus   @default(COMPLETED)
  createdAt   DateTime           @default(now())

  @@index([investorId])
}

enum InvestorTxType {
  TOPUP
  WITHDRAWAL
  INVESTMENT
  PAYOUT
  SAFE_LOCK
  SAFE_UNLOCK
  SAFE_INTEREST
  REFERRAL_BONUS
}

enum InvestorWalletKind {
  MAIN
  PAYOUT
  SAFE
}

enum InvestorTxStatus {
  PENDING
  COMPLETED
  FAILED
}

model InvestmentAsset {
  id                String                  @id @default(cuid())
  name              String
  shortCode         String
  vehicleClass      InvestmentVehicleClass
  description       String?
  location          String?
  imageUrl          String?
  unitPriceKobo     Int
  minInvestKobo     Int
  projectedRoiBps   Int
  tenureMonths      Int
  monthlyPayoutKobo Int
  targetKobo        Int
  raisedKobo        Int                     @default(0)
  slotsTotal        Int
  slotsLeft         Int
  investorCount     Int                     @default(0)
  isHot             Boolean                 @default(false)
  status            InvestmentAssetStatus   @default(OPEN)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  investments Investment[]
}

enum InvestmentVehicleClass {
  KEKE
  SHUTTLE
  RIDE_CAR
  BIKE
}

enum InvestmentAssetStatus {
  OPEN
  FUNDED
  CLOSED
}

model InvestmentPlan {
  id             String   @id @default(cuid())
  name           String
  tenureMonths   Int
  monthlyRateBps Int
  minAmountKobo  Int
  note           String?
  isPopular      Boolean  @default(false)
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  investments Investment[]
}

model Investment {
  id                String             @id @default(cuid())
  reference         String             @unique
  investorId        String
  investor          Investor           @relation(fields: [investorId], references: [id])
  assetId           String
  asset             InvestmentAsset    @relation(fields: [assetId], references: [id])
  planId            String
  plan              InvestmentPlan     @relation(fields: [planId], references: [id])
  amountKobo        Int
  monthlyPayoutKobo Int
  status            InvestmentStatus   @default(PENDING_PAYMENT)
  startedAt         DateTime?
  maturesAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  payouts InvestmentPayout[]

  @@index([investorId])
  @@index([assetId])
}

enum InvestmentStatus {
  PENDING_PAYMENT
  ACTIVE
  MATURED
  CANCELLED
}

model InvestmentPayout {
  id           String                 @id @default(cuid())
  investmentId String
  investment   Investment             @relation(fields: [investmentId], references: [id])
  sequence     Int
  dueDate      DateTime
  amountKobo   Int
  status       InvestmentPayoutStatus @default(SCHEDULED)
  paidAt       DateTime?

  @@unique([investmentId, sequence])
  @@index([investmentId])
}

enum InvestmentPayoutStatus {
  SCHEDULED
  PAID
}

model FlowSafeVault {
  id                 String             @id @default(cuid())
  investorId         String
  investor           Investor           @relation(fields: [investorId], references: [id])
  name               String
  kind               FlowSafeVaultKind
  principalKobo      Int
  interestRateBps    Int
  interestEarnedKobo Int                @default(0)
  lockDays           Int?
  unlocksAt          DateTime?
  status             FlowSafeVaultStatus @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([investorId])
}

enum FlowSafeVaultKind {
  FLEXIBLE
  LOCKED
}

enum FlowSafeVaultStatus {
  ACTIVE
  CLOSED
}

model InvestorBankAccount {
  id            String   @id @default(cuid())
  investorId    String
  investor      Investor @relation(fields: [investorId], references: [id])
  bankName      String
  bankCode      String
  accountNumber String
  accountName   String
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([investorId])
}

model InvestorNotification {
  id         String   @id @default(cuid())
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id])
  title      String
  body       String
  category   String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([investorId])
}
