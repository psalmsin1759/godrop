# Base URL of the GoDrop backend API (apps/backend), including /api/v1
BACKEND_API_URL=http://localhost:4000/api/v1

# JWT for the customer this MCP server acts on behalf of.
# Get one by logging in as a test customer, e.g.:
#   curl -X POST $BACKEND_API_URL/auth/login -d '{"phone":"...","password":"..."}' -H 'content-type: application/json'
# and copying the accessToken from the response.
CUSTOMER_JWT=
